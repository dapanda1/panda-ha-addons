# Force LF line endings on files that run inside the Linux container.
# Without this, Windows clients may commit CRLF and break the add-on at runtime.
*.sh           text eol=lf
*.py           text eol=lf
Dockerfile     text eol=lf
**/run         text eol=lf
**/up          text eol=lf
**/finish      text eol=lf
**/type        text eol=lf
**/contents.d/* text eol=lf
**/dependencies.d/* text eol=lf

# YAML/Markdown can stay platform-neutral but LF is safest for CI consistency
*.yaml         text eol=lf
*.yml          text eol=lf
*.md           text eol=lf
*.json         text eol=lf

# Binary
*.png          binary
*.jpg          binary
*.ico          binary
*.gz           binary
